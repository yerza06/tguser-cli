# Учётные данные приложения Telegram (получить на https://my.telegram.org → API development tools)
TGUSER_API_ID=1234567
TGUSER_API_HASH=0123456789abcdef0123456789abcdef

# Необязательно: номер телефона для входа (иначе `tguser login` спросит его и сохранит сюда)
# TGUSER_PHONE_NUMBER=+15551234567

# Необязательно: переопределить расположение конфига/сессии/БД
# TGUSER_CONFIG_DIR=~/.config/tguser
# TGUSER_SESSION_NAME=tguser
